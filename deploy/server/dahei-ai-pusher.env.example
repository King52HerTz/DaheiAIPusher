# 复制到 /etc/dahei-ai-pusher.env 后再填写。
# AppToken 属于应用密钥，不要提交真实值，也不要截图发到 Issue。
WXPUSHER_APP_TOKEN='AT_xxx'
WXPUSHER_UID=''
WXPUSHER_TOPIC_IDS='123456'

# 启用哪些推送通道：wxpusher,email,feishu（逗号分隔；默认 wxpusher，保持原有行为）
PUSH_CHANNELS='wxpusher'

# ── QQ 邮箱通道（PUSH_CHANNELS 含 email 时必填）──
# 授权码在 QQ 邮箱「设置 → 账号 → 开启 SMTP 服务」后生成，不是 QQ 登录密码。
EMAIL_SMTP_HOST='smtp.qq.com'
EMAIL_SMTP_PORT='465'
EMAIL_SMTP_SSL='true'
EMAIL_SMTP_USER=''
EMAIL_SMTP_AUTH_CODE=''
EMAIL_TO=''
# 可选：覆盖显示的发件地址，默认同 EMAIL_SMTP_USER
EMAIL_FROM=''

# ── 飞书通道（PUSH_CHANNELS 含 feishu 时必填）──
# 群设置 → 群机器人 → 添加自定义机器人；安全设置建议选「签名校验」。
FEISHU_WEBHOOK_URL=''
FEISHU_SECRET=''

CONTENT_MODE='full'
RSS_URL='https://news.daheiai.com/rss.php'
STATE_FILE='/var/lib/dahei-ai-pusher/state.json'
MAX_CATCHUP_ITEMS='6'
HTTP_CONNECT_TIMEOUT='10'
HTTP_READ_TIMEOUT='20'
